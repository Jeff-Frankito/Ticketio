
# =============================================================================
# TICKETIO - GIT IGNORE
# =============================================================================
#
# Stack:
#   PHP 8.3 / Slim 4 / PHP-DI / BladeOne / PHPMailer
#   Nginx / Docker / Microsoft SQL Server / Mailpit
#   Microsoft.Build.Sql / VS Code
#
# Purpose:
#   Ignore generated files, dependencies, secrets, caches, runtime data,
#   temporary files, local development settings and build artefacts.
#
# =============================================================================


# =============================================================================
# 01. ENVIRONMENT VARIABLES & SECRETS
# =============================================================================

.env
.env.*
!.env.example
!.env.sample
!.env.template

*.env.local
*.secret
*.secrets
*.credentials

secrets/
private/
credentials/

*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.asc

id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

auth.json
**/auth.json


# =============================================================================
# 02. COMPOSER & PHP DEPENDENCIES
# =============================================================================

/vendor/
/composer.phar

.phpunit-watcher.yml

# Keep dependency definitions and lock files version controlled.
!/composer.json
!/composer.lock


# =============================================================================
# 03. BLADEONE TEMPLATE CACHE
# =============================================================================

/cache/*
!/cache/.gitkeep

*.blade.php.cache
*.blade.php.tmp


