# Copy this file to .env and set your own SQL Server password before starting Docker Compose.

# Application
APP_ENV=development
APP_URL=http://127.0.0.1:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SQL Server: choose a strong password with uppercase, lowercase, numbers and symbols.
# Docker Compose also passes this password to PHP as DB_PASSWORD.
MSSQL_SA_PASSWORD=replace-with-your-own-strong-password
DB_HOST=mssql
DB_PORT=1433
DB_NAME=Ticketio
DB_USER=sa

# Local mail delivery (Mailpit inbox: http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@ticketio.test
MAIL_FROM_NAME=Ticketio
